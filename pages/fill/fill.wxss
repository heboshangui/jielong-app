page { background: #f0f4f8; font-family: 'PingFang SC', sans-serif; }
.container { padding: 24rpx; padding-bottom: 100rpx; }
.header { background: white; border-radius: 16rpx; padding: 32rpx 28rpx; margin-bottom: 20rpx; }
.form-title { font-size: 36rpx; font-weight: 700; color: #1a1a1a; display: block; margin-bottom: 12rpx; }
.desc { font-size: 28rpx; color: #666; background: #f8f8f8; padding: 16rpx; border-radius: 10rpx; margin-top: 12rpx; }
.deadline { font-size: 26rpx; color: #856404; background: #fff3cd; padding: 10rpx 16rpx; border-radius: 8rpx; margin-top: 12rpx; display: inline-block; }
.checkin-range { font-size: 26rpx; color: #555; background: #f0f4f8; padding: 10rpx 16rpx; border-radius: 8rpx; margin-top: 12rpx; display: inline-block; }
.form-body { background: white; border-radius: 16rpx; padding: 28rpx; }
.field { margin-bottom: 32rpx; }
.field-label { font-size: 28rpx; font-weight: 600; color: #333; margin-bottom: 12rpx; display: block; }
.red { color: #ff4d4f; }
.field-input { border: 2rpx solid #e8e8e8; border-radius: 12rpx; padding: 20rpx 24rpx; font-size: 30rpx; width: 100%; box-sizing: border-box; }
.radio-item { display: flex; align-items: center; gap: 12rpx; font-size: 28rpx; color: #333; padding: 10rpx 0; }
.image-upload-area { border: 2rpx dashed #ccc; border-radius: 12rpx; overflow: hidden; min-height: 200rpx; display: flex; align-items: center; justify-content: center; }
.upload-placeholder { text-align: center; padding: 40rpx; }
.upload-icon { display: block; font-size: 60rpx; color: #ccc; line-height: 1; }
.upload-text { display: block; font-size: 26rpx; color: #aaa; margin-top: 8rpx; }
.uploaded-img { width: 100%; height: 300rpx; display: block; }
.sign-preview { border: 2rpx solid #e8e8e8; border-radius: 12rpx; overflow: hidden; min-height: 150rpx; display: flex; align-items: center; justify-content: center; background: #fafafa; }
.sign-placeholder { text-align: center; padding: 30rpx; }
.sign-icon { display: block; font-size: 48rpx; }
.sign-text { display: block; font-size: 26rpx; color: #aaa; margin-top: 8rpx; }
.sign-img { width: 100%; height: 200rpx; display: block; }
.btn-submit { background: #07c160; color: white; border-radius: 24rpx; font-size: 34rpx; font-weight: 600; padding: 28rpx 0; border: none; margin-top: 20rpx; width: 100%; }

/* 签名弹窗 */
.sign-modal { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 999; display: flex; align-items: center; justify-content: center; }
.sign-modal-mask { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); }
.sign-modal-content { position: relative; background: white; border-radius: 20rpx; padding: 32rpx; width: 90%; max-width: 600rpx; z-index: 1; box-shadow: 0 8rpx 40rpx rgba(0,0,0,0.2); }
.sign-modal-header { text-align: center; margin-bottom: 24rpx; }
.sign-modal-title { font-size: 32rpx; font-weight: 700; color: #333; }
.sign-canvas-wrap { border: 2rpx solid #ccc; border-radius: 12rpx; overflow: hidden; margin-bottom: 24rpx; }
.sign-canvas { width: 100%; height: 350rpx; background: white; display: block; }
.sign-modal-btns { display: flex; gap: 16rpx; }
.sign-btn { flex: 1; text-align: center; padding: 20rpx 0; border-radius: 12rpx; font-size: 28rpx; font-weight: 600; }
.sign-btn.clear { background: #f5f5f5; color: #666; }
.sign-btn.cancel { background: #f5f5f5; color: #666; }
.sign-btn.confirm { background: #07c160; color: white; }
