<view class="container" wx:if="{{form}}">
  <view class="stat-row">
    <view class="stat-card">
      <text class="stat-num">{{allCount}}/{{totalCount}}</text>
      <text class="stat-label">{{form.formType==='checkin'?'今日打卡':'已完成人数'}}</text>
    </view>
    <view class="stat-info">
      <view class="progress-bar"><view class="progress-fill" style="width:{{allCount/totalCount*100}}%"></view></view>
      <text class="remain">{{totalCount-allCount}}人未完成</text>
    </view>
  </view>

  <view class="action-row">
    <view class="action-btn share" bindtap="copyShareLink">🔗 分享链接</view>
    <view class="action-btn remind" bindtap="showRemind">🔔 一键提醒</view>
    <view class="action-btn export" bindtap="exportExcel">📥 导出Excel</view>
  </view>

  <view class="action-row" wx:if="{{form.formType==='checkin'}}">
    <view class="action-btn history" bindtap="goHistory">📊 打卡历史</view>
  </view>

  <view class="info-row" wx:if="{{form.formType==='checkin'}}">
    <text>📅 {{form.startDate}} 至 {{form.endDate}}</text>
    <text wx:if="{{form.reminderEnabled}}">⏰ {{form.reminderTime}} 提醒</text>
    <text wx:if="{{form.allowMakeup}}">✅ 允许补卡</text>
  </view>

  <view class="search-row">
    <input class="search-input" placeholder="搜索幼儿姓名…" bindinput="onSearch" value="{{searchKey}}" />
  </view>

  <view class="section-title">接龙名单（共{{responses.length}}条）</view>

  <view class="record-item" wx:for="{{responses}}" wx:key="id">
    <view class="record-header">
      <text class="record-name">{{item.data.幼儿姓名 || '未知'}}</text>
      <text class="record-badge">✓ 已{{form.formType==='checkin'?'打卡':'完成'}}</text>
    </view>
    <view class="record-detail">
      <text wx:if="{{item.data['家长/监护人']}}">👤 {{item.data['家长/监护人']}}</text>
      <text wx:if="{{item.data['联系电话']}}">📞 {{item.data['联系电话']}}</text>
      <text wx:if="{{item.data['是否已认真阅读并对幼儿负责']}}">✔️ {{item.data['是否已认真阅读并对幼儿负责']}}</text>
    </view>
    <view class="record-time">{{item.submittedAt ? new Date(item.submittedAt).toLocaleString('zh-CN') : ''}}</view>
  </view>

  <view wx:if="{{responses.length===0}}" class="empty">暂无数据</view>
</view>
