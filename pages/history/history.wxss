.container {
  padding: 24rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.header-card {
  background: #07c160;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  color: #fff;
}

.form-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.form-meta {
  font-size: 24rpx;
  opacity: 0.85;
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.stats-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stat-box {
  flex: 1;
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx 16rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.stat-num {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #07c160;
}

.stat-lbl {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.search-row {
  margin-bottom: 16rpx;
}

.search-input {
  background: #fff;
  border-radius: 40rpx;
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  border: 2rpx solid #e0e0e0;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.person-card {
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.person-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
}

.person-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.person-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.person-count {
  font-size: 24rpx;
  color: #07c160;
  background: #e8f8ef;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}

.expand-icon {
  font-size: 24rpx;
  color: #999;
}

.date-list {
  border-top: 1rpx solid #f0f0f0;
  padding: 16rpx 24rpx;
}

.date-group {
  margin-bottom: 16rpx;
}

.date-label {
  font-size: 24rpx;
  color: #666;
  background: #f9f9f9;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 8rpx;
  display: inline-block;
}

.record-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 8rpx 0 8rpx 16rpx;
}

.rec-time {
  font-size: 24rpx;
  color: #999;
}

.rec-status {
  font-size: 24rpx;
  color: #07c160;
}

.no-records {
  padding: 16rpx;
  text-align: center;
  color: #999;
  font-size: 24rpx;
}

.empty {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 28rpx;
}
